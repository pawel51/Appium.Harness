<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted for reuse: net8.0 is the current LTS, net10.0 matches the newest test
         projects. Nothing here is TFM-specific. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Appium.Harness</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet packaging. Shared metadata (authors, licence, repository) is in Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Appium.Harness</PackageId>
    <Version>2.2.0</Version>
    <Description>
      A test-framework-agnostic helper layer over Appium for .NET MAUI (and other mobile) UI
      tests: element lookup by automation id, resilient waits, precise no-fling gestures,
      waiting assertions with useful failure messages, hybrid WebView support, and local/cloud
      session setup. Works with NUnit, xUnit, MSTest or none — it takes no dependency on a
      test framework.
    </Description>
    <PackageTags>appium;uitest;e2e;maui;android;ios;mobile;automation;webview;selenium</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The expectation engine is exercised without a device through fake element probes. -->
    <InternalsVisibleTo Include="Appium.Harness.Tests" />
    <!-- Lets NSubstitute (Castle DynamicProxy) fake the internal INativeScreen seam. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately no NUnit/xUnit/MSTest reference: the consumer picks the test framework,
         and a harness that drags one in cannot be used from another. That is the invariant —
         no *test framework*, which Selenium is not.

         Selenium.WebDriver is declared explicitly rather than taken transitively because
         WebUi is built on IWebDriver and it should be honest about that. Appium.WebDriver 8.0.1
         only asks for Selenium.WebDriver 4.35.0 or later; this raises the floor to 4.40.0 so
         consumers get the current Selenium without having to reference it themselves. -->
    <PackageReference Include="Appium.WebDriver" Version="8.0.1" />
    <PackageReference Include="Selenium.WebDriver" Version="4.40.0" />
  </ItemGroup>

</Project>
